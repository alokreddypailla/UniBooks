# ============================================================
# UniBooks Exchange — .gitignore
# ============================================================

# Environment variables — NEVER commit these
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/

# Node / React
node_modules/
dist/
.vite/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
